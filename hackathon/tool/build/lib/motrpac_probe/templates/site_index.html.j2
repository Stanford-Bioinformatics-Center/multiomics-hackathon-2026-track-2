{#- motrpac_probe gallery index: a plain table, one row per example report. -#}
{% from "report.html.j2" import sort_script %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="motrpac_probe {{ tool_version }}">
<title>{{ title }}</title>
<style>
{{ css }}
</style>
</head>
<body>
<main>
<header class="title-block">
<h1>{{ title }}</h1>
</header>
{% if intro %}
<div class="site-intro">
{% for line in intro %}<p>{{ line }}</p>
{% endfor %}
</div>
{% endif %}
<h2>Examples</h2>
<div class="table-wrap">
<table id="examples" class="data sortable">
<thead><tr>
<th scope="col">Example</th>
<th scope="col">Description</th>
<th scope="col" class="num">Genes</th>
{% for c in headline_cols %}<th scope="col">{{ c }}</th>
{% endfor %}
</tr></thead>
<tbody>
{% for r in rows %}
<tr>
<td><a href="{{ r.href or r.report }}">{{ r.name }}</a></td>
<td>{{ r.description }}</td>
<td class="num">{% if r.n_genes is defined and r.n_genes is not none %}{{ r.n_genes }}{% else %}<span class="na">not measured</span>{% endif %}</td>
{% for c in headline_cols %}{% set v = (r.headline or {}).get(c) %}<td>{% if v is none or v == "" %}<span class="na">not measured</span>{% else %}{{ v }}{% endif %}</td>
{% endfor %}
</tr>
{% endfor %}
</tbody>
</table>
</div>
<footer>Generated by motrpac_probe {{ tool_version }}. Each example links to a single-file HTML report.</footer>
</main>
{{ sort_script() }}
</body>
</html>
